    }
  ],
  "narrative": {
    "northStar": "The Meal Ticket",
    "overview": "A small lunch-counter meal ticket makes a review feel personal and easy to finish. Warm ivory surrounds white paper; pale periwinkle, light blue and lilac give the controls a friendly character. Charcoal type and visible rules keep the soft palette readable.\n\nBold Libre Caslon Text supplies the inviting voice, while DM Sans keeps names, labels and scores easy to scan. Circles identify friends; a pair of side notches gives the meal form its signature. The visual language stays quiet enough for honest opinions to lead.",
    "keyCharacteristics": [
      "Warm paper and white tickets with restrained, cool pastel accents.",
      "Expressive serif headings paired with clear sans-serif controls.",
      "Named friend avatars, visible selected states and short, conversational labels.",
      "Mostly flat surfaces; subtle shadow reserved for the ticket and search results."
    ],
    "rules": [
      {
        "name": "The Readable Pastel Rule",
        "body": "Put dark indigo lettering on pale blue and purple fills. Keep input boundaries and ticket rules visibly separate from white.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Libre Caslon Text for major headings and DM Sans for controls, names, scores and body copy.",
        "section": "typography"
      },
      {
        "name": "The Paper Rule",
        "body": "Use white, fine borders and breathing room to group content. Keep the meal ticket’s soft lift and notches distinctive.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing light blue and light purple palette with dark, readable text.",
      "Do preserve explicit selected, focus, pending and error states.",
      "Do identify friends with names as well as pastel initials.",
      "Do let the layout scroll naturally and reserve space for fixed mobile navigation.",
      "Do keep unavailable and empty states honest; illustrative meals are not production reviews."
    ],
    "donts": [
      "Don’t replace the meal-ticket identity with a dense dashboard or decorative card grid.",
      "Don’t use pale decorative dividers as the boundary of an editable field.",
      "Don’t replace decimal entry with integer-only score shortcuts.",
      "Don’t add entrance choreography or large shadows to routine controls."
    ]
  }
}
