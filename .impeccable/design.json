    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat content container showing an honest unavailable state.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-title\">The journal isn’t ready just yet.</h2><p class=\"ds-copy\">Our places and reviews will appear here once the journal is connected.</p></section>",
      "css": ".ds-panel{min-width:0;border:1px solid var(--color-line,#dfdfe5);background:var(--surface,#fff);border-radius:14px;padding:24px;color:var(--color-ink,#282b32);font-family:var(--font-journal-sans,\"DM Sans\",sans-serif);}.ds-title{margin:0 0 8px;font-size:20px;font-weight:700;line-height:1.2;letter-spacing:-.025em}.ds-copy{margin:0;color:var(--color-muted,#676773);font-size:14px;line-height:1.6}"
    },
    {
      "name": "Meal ticket",
      "kind": "custom",
      "refersTo": "meal-ticket",
      "description": "White paper, notched sides and visible ticket rule.",
      "html": "<section class=\"ds-ticket\"><div class=\"ds-ticket-place\"><label class=\"ds-label\" for=\"ds-ticket-place\">The place</label><input class=\"ds-input\" id=\"ds-ticket-place\" placeholder=\"Find a place or add a new one\"/></div><button class=\"ds-btn ds-ticket-save\">Save my review</button></section>",
      "css": ".ds-label{display:block;margin-bottom:7px;font-size:13px;font-weight:700;color:var(--color-ink,#282b32);font-family:var(--font-journal-sans,\"DM Sans\",sans-serif);}.ds-input{width:100%;max-width:100%;min-height:46px;border:1px solid var(--field-line,#8d919f);border-radius:10px;padding:11px 13px;background:var(--surface,#fff);color:var(--color-ink,#282b32);font-size:15px;transition:border-color .18s;font-family:var(--font-journal-sans,\"DM Sans\",sans-serif);}.ds-input::placeholder{color:#747480;opacity:1}.ds-input:hover{border-color:#797f90}.ds-input:focus{border-color:var(--color-accent,#565c9c)}.ds-input[aria-invalid=\"true\"]{border-color:#a73e53}.ds-input:focus-visible{outline:3px solid var(--color-accent,#565c9c);outline-offset:4px;}@media(max-width:600px){.ds-input{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}.ds-btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;min-height:46px;padding:11px 20px;border:1px solid transparent;border-radius:10px;background:var(--accent-soft,#cbd0fa);color:var(--accent-ink,#303658);font-size:14px;font-weight:700;text-align:center;cursor:pointer;transition:background .18s,box-shadow .18s;font-family:var(--font-journal-sans,\"DM Sans\",sans-serif);}.ds-btn:hover{background:var(--accent-hover,#bbc3f5)}.ds-btn:active{background:#aeb8f0}.ds-btn:disabled{opacity:.6;cursor:wait}.ds-btn:focus-visible{outline:3px solid var(--color-accent,#565c9c);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}.ds-ticket{position:relative;padding:26px 28px 28px;border-radius:16px;background:var(--surface,#fff);box-shadow:0 4px 16px #30354e0b,0 2px 4px #30354e08}.ds-ticket-place{position:relative;margin-bottom:22px;padding-bottom:24px;border-bottom:1px solid var(--ticket-rule,#9699a5)}.ds-ticket-place:before,.ds-ticket-place:after{position:absolute;bottom:-10px;width:20px;height:20px;border-radius:50%;background:var(--color-paper,#faf9f5);content:\"\"}.ds-ticket-place:before{left:-38px}.ds-ticket-place:after{right:-38px}.ds-ticket-save{width:100%;min-height:50px;font-size:17px}@media(max-width:600px){.ds-ticket{padding:18px}.ds-ticket-place{padding-bottom:16px;margin-bottom:16px}.ds-ticket-place:before{left:-28px}.ds-ticket-place:after{right:-28px}.ds-ticket-save{font-size:16px}}"
    },
    {
      "name": "Rating cell",
      "kind": "button",
      "refersTo": "rating-option",
      "description": "Integer shortcut; selected state has aria-pressed and an inset mark.",
      "html": "<div class=\"ds-ratings\" role=\"group\" aria-label=\"Rating state previews\"><button class=\"ds-rating\" aria-pressed=\"false\">7</button><button class=\"ds-rating\" aria-pressed=\"true\">8</button><button class=\"ds-rating\" aria-pressed=\"false\">9</button></div>",
