# Neon pooled PostgreSQL connection string. Server-only; never prefix NEXT_PUBLIC_.
DATABASE_URL=
# Optional direct Neon connection string for migrations; defaults to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Calendar timezone for visit dates (shared by the group).
APP_TIME_ZONE=America/Los_Angeles
# External place search/discovery is intentionally unconfigured.
# Server-only recommendation service. Vercel injects RECOMMENDER_URL through
# the web -> recommender binding; set this URL manually for local development.
RECOMMENDER_URL=http://127.0.0.1:8001
# Same cryptographically random secret (at least 32 characters) in both services.
# Never use NEXT_PUBLIC_ or send this value to browser code.
RECOMMENDER_SHARED_SECRET=
# Server-side Vercel AI Gateway model. Vercel deployments may authenticate with OIDC.
AI_SUMMARY_MODEL=
AI_GATEWAY_API_KEY=
# Bounded generation controls: one attempt can take at most 30 seconds; retry count caps at two.
AI_SUMMARY_TIMEOUT_MS=12000
AI_SUMMARY_MAX_RETRIES=2
